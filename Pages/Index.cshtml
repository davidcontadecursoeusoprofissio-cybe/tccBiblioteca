@page
@model CadastroLivrosModel

<h1>Biblioteca</h1>

<div>
    <form method="post">
        @Html.AntiForgeryToken()
        
        <label for="titulo">digite o título do livro</label>
        <input id="titulo" name="titulo" type="text" required />

        <label for="capa">cole a URL da capa</label>
        <input id="capa" name="capa" type="text" required />

        <button class="button2" type="submit">Cadastrar</button>
    </form>
</div>
